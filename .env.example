OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional: a stronger model for scoring only (must support structured outputs). Defaults to OPENROUTER_MODEL.
# OPENROUTER_EVAL_MODEL=anthropic/claude-sonnet-5
PORT=3000

# Abuse / budget limits (defaults shown)
ROASTS_PER_DEVICE_PER_DAY=1
ROASTS_PER_IP_PER_DAY=5
ROASTS_PER_DAY=200
# USAGE_FILE=./data/usage.json
# Salt for hashing device ids and IPs. Defaults to your API key; set your own if you rotate keys.
# USAGE_SALT=change-me
# Required to read /api/stats from anywhere other than localhost.
# ADMIN_TOKEN=pick-a-long-random-string

# Usage limits are enforced in Redis when these are set (required on Vercel — serverless
# functions have no persistent disk). Provisioned automatically by `vercel integration add
# upstash/upstash-kv` and connected to the project; pull the values with `vercel env pull`.
# Without these, the app falls back to the local JSON file above.
# KV_REST_API_URL=https://your-db.upstash.io
# KV_REST_API_TOKEN=your-upstash-rest-token
